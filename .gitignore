/target/
**/target/

# Jit lock files (temporary coordination)
.jit/**/*.lock
.jit-bootstrap.lock

# Jit server runtime files (ephemeral, machine-specific)
.jit/server.log
.jit/server.pid.json

# Jit worktree identity (machine-specific, regenerated on init — never commit)
.jit/worktree.json


# Coverage badge artifacts
coverage.json
badges/

# jit-execution-lead worktrees (transient, never tracked)
.agents/worktrees/

# user-local Claude config (canonical skills live in .agents/skills)
.claude/
