+//! Executed contract coverage for the shell compiler wrapper used by cargo-ci
+//! (jit:b883f916 REQ-01/REQ-02).
+
+use std::path::Path;
+use std::process::Command;
+
+#[test]
+fn test_jit_rustc_workspace_wrapper_selftest_passes() {
+    let workspace_root = Path::new(env!("CARGO_MANIFEST_DIR"))
+        .parent()
+        .and_then(Path::parent)
+        .expect("workspace root is two levels above the jit crate manifest");
+    let selftest = workspace_root.join("scripts/jit-rustc-workspace-wrapper-selftest.sh");
+    let output = Command::new(&selftest)
+        .current_dir(workspace_root)
+        .output()
+        .unwrap_or_else(|error| panic!("run {}: {error}", selftest.display()));
+
+    assert!(
+        output.status.success(),
+        "wrapper selftest failed\nstdout:\n{}\nstderr:\n{}",
+        String::from_utf8_lossy(&output.stdout),
+        String::from_utf8_lossy(&output.stderr)
+    );
+    assert!(
+        String::from_utf8_lossy(&output.stdout).contains("SELFTEST: all assertions passed"),
+        "wrapper selftest did not report its complete assertion set"
+    );
+}
