index 0000000000000000000000000000000000000000..da18675b77cb9a9b0468d9c68b825ac6105d3309
--- /dev/null
+++ b/scripts/jit-rustc-workspace-wrapper.sh
@@ -0,0 +1,135 @@
+#!/usr/bin/env bash
+# Optimize only the ordinary jit library compiler unit. Cargo invokes
+# a workspace wrapper as: wrapper <rustc> <rustc-args...>. All non-matching
+# units are replaced by the real compiler process with their original argv.
+#
+# This parser never evaluates compiler arguments. An eligible invocation that
+# already names any opt-level is rejected: silently appending a second setting
+# would make argument order, rather than this classifier, the authority.
+set -uo pipefail
+
+if [[ "$#" -lt 1 ]]; then
+  echo "jit-rustc-workspace-wrapper: missing rustc executable" >&2
+  exit 86
+fi
+
+rustc=$1
+shift
+args=("$@")
+package=${CARGO_PKG_NAME:-}
+crate=''
+crate_name_count=0
+has_test=0
+opt_level_count=0
+
+for ((index = 0; index < ${#args[@]}; index++)); do
+  arg=${args[index]}
+  case "$arg" in
+    --crate-name)
+      if ((index + 1 < ${#args[@]})); then
+        crate=${args[index + 1]}
+        ((crate_name_count += 1))
+        ((index += 1))
+      else
+        ((crate_name_count += 2))
+      fi
+      ;;
+    --crate-name=*)
+      crate=${arg#--crate-name=}
+      ((crate_name_count += 1))
+      ;;
+    --test)
+      has_test=1
+      ;;
+    -C | --codegen)
+      if ((index + 1 < ${#args[@]})) && [[ "${args[index + 1]}" == opt-level=* ]]; then
+        ((opt_level_count += 1))
+      fi
+      ;;
+    -Copt-level=* | -C=opt-level=* | --codegen=opt-level=*)
+      ((opt_level_count += 1))
+      ;;
+  esac
+done
+
+# Cargo runs rustc from the workspace root. Canonicalizing both the known roots
+# and matching .rs arguments rejects lookalike relative paths and accepts only
+# paths resolving to the two tracked source files in this exact checkout. The
+# CLI main remains recognized for an explicit audited passthrough decision.
+expected_lib=$(realpath -e -- crates/jit/src/lib.rs 2>/dev/null || true)
+expected_main=$(realpath -e -- crates/jit/src/main.rs 2>/dev/null || true)
+canonical_root=''
+root_match_count=0
+if [[ -n "$expected_lib" && -n "$expected_main" ]]; then
+  for arg in "${args[@]}"; do
+    [[ "$arg" == *.rs ]] || continue
+    candidate=$(realpath -e -- "$arg" 2>/dev/null || true)
+    if [[ "$candidate" == "$expected_lib" || "$candidate" == "$expected_main" ]]; then
+      canonical_root=$candidate
+      ((root_match_count += 1))
+    fi
+  done
+fi
+
+decision=passthrough
+reason=unmatched
+eligible=0
+if [[ "$package" == jit && "$crate" == jit && "$crate_name_count" -eq 1 && \
+      "$root_match_count" -eq 1 && "$canonical_root" == "$expected_lib" && \
+      "$has_test" -eq 0 ]]; then
+  eligible=1
+  decision=optimize
+  reason=ordinary-jit-library
+fi
+
+if [[ "$eligible" -eq 1 && "$opt_level_count" -ne 0 ]]; then
+  decision=reject
+  reason=preexisting-opt-level
+fi
+
+write_audit_record() {
+  local audit_dir=${JIT_RUSTC_WRAPPER_AUDIT_DIR:-}
+  [[ -n "$audit_dir" ]] || return 0
+  if [[ ! -d "$audit_dir" || -L "$audit_dir" ]]; then
+    echo "jit-rustc-workspace-wrapper: audit destination is not an ordinary directory: $audit_dir" >&2
+    return 1
+  fi
+
+  local partial published
+  partial=$(mktemp "$audit_dir/.partial.XXXXXX") || return 1
+  published=${partial/.partial./invocation.}
+  if ! printf '%s\0' \
+      'version=1' \
+      "package=$package" \
+      "crate=$crate" \
+      "crate_name_count=$crate_name_count" \
+      "root=$canonical_root" \
+      "root_match_count=$root_match_count" \
+      "has_test=$has_test" \
+      "opt_level_count=$opt_level_count" \
+      "decision=$decision" \
+      "reason=$reason" >"$partial"; then
+    rm -f -- "$partial"
+    return 1
+  fi
+  chmod 0444 "$partial" || {
+    rm -f -- "$partial"
+    return 1
+  }
+  mv -- "$partial" "$published"
+}
+
+if ! write_audit_record; then
+  echo "jit-rustc-workspace-wrapper: could not publish the compiler audit record" >&2
+  exit 86
+fi
+
+if [[ "$decision" == reject ]]; then
+  echo "jit-rustc-workspace-wrapper: refusing eligible jit invocation with a preexisting opt-level" >&2
+  exit 86
+fi
+
+if [[ "$decision" == optimize ]]; then
+  exec "$rustc" "${args[@]}" -C opt-level=1
+fi
+exec "$rustc" "${args[@]}"
diff --git a/scripts/stage-jit-rustc-workspace-wrapper.sh b/scripts/stage-jit-rustc-workspace-wrapper.sh
