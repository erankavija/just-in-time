--- /dev/null
+++ b/scripts/jit-rustc-workspace-wrapper-selftest.sh
@@ -0,0 +1,215 @@
+#!/usr/bin/env bash
+# Contract tests for the ordinary-jit-library rustc workspace wrapper and its
+# content-addressed staging helper (jit:b883f916 REQ-01/REQ-02).
+set -uo pipefail
+
+root=$(cd "$(dirname "$0")/.." && pwd)
+wrapper="$root/scripts/jit-rustc-workspace-wrapper.sh"
+stager="$root/scripts/stage-jit-rustc-workspace-wrapper.sh"
+scratch=$(mktemp -d)
+trap 'rm -rf "$scratch"' EXIT
+
+fail=0
+check() {
+  local message="$1"
+  shift
+  if "$@"; then
+    printf 'PASS: %s\n' "$message"
+  else
+    printf 'FAIL: %s\n' "$message"
+    fail=1
+  fi
+}
+
+if [[ ! -x "$wrapper" || ! -x "$stager" ]]; then
+  printf 'FAIL: wrapper and stager must exist and be executable\n'
+  exit 1
+fi
+
+fake_rustc="$scratch/fake rustc"
+cat >"$fake_rustc" <<'EOF'
+#!/usr/bin/env bash
+if [[ -n "${FAKE_CAPTURE:-}" ]]; then
+  printf '%s\0' "$@" >"$FAKE_CAPTURE"
+fi
+printf '%s' "${FAKE_STDOUT:-}"
+printf '%s' "${FAKE_STDERR:-}" >&2
+case "${FAKE_ACTION:-exit}" in
+  exit) exit "${FAKE_STATUS:-0}" ;;
+  term) kill -TERM "$$"; sleep 1 ;;
+esac
+EOF
+chmod +x "$fake_rustc"
+
+run_capture() {
+  local capture="$1"
+  shift
+  (
+    cd "$root" || exit 99
+    CARGO_PKG_NAME=jit FAKE_CAPTURE="$capture" "$wrapper" "$fake_rustc" "$@"
+  )
+}
+
+assert_args() {
+  local capture="$1"
+  shift
+  python3 - "$capture" "$@" <<'PY'
+import pathlib
+import sys
+
+actual = pathlib.Path(sys.argv[1]).read_bytes().split(b"\0")
+if actual[-1:] == [b""]:
+    actual.pop()
+expected = [value.encode() for value in sys.argv[2:]]
+raise SystemExit(0 if actual == expected else 1)
+PY
+}
+
+capture="$scratch/eligible-lib.args"
+run_capture "$capture" --crate-name jit crates/jit/src/lib.rs --crate-type lib
+check "eligible library gets one trailing opt-level argument" assert_args "$capture" \
+  --crate-name jit crates/jit/src/lib.rs --crate-type lib -C opt-level=1
+
+capture="$scratch/ordinary-main.args"
+run_capture "$capture" crates/jit/src/main.rs --crate-name=jit --crate-type bin
+check "ordinary CLI main passes through byte-for-byte" assert_args "$capture" \
+  crates/jit/src/main.rs --crate-name=jit --crate-type bin
+
+passthrough_case() {
+  local name="$1" package="$2"
+  shift 2
+  local capture="$scratch/$name.args"
+  (
+    cd "$root" || exit 99
+    CARGO_PKG_NAME="$package" FAKE_CAPTURE="$capture" "$wrapper" "$fake_rustc" "$@"
+  ) || return 1
+  assert_args "$capture" "$@"
+}
+
+check "library test harness passes through byte-for-byte" passthrough_case harness jit \
+  --crate-name jit --test crates/jit/src/lib.rs
+check "integration test crate passes through byte-for-byte" passthrough_case integration jit \
+  --crate-name cli_gate crates/jit/tests/cli_gate/main.rs --test
+check "server artifact passes through byte-for-byte" passthrough_case server jit-server \
+  --crate-name jit_server crates/server/src/lib.rs
+check "dependency passes through byte-for-byte" passthrough_case dependency serde \
+  --crate-name serde /registry/serde/src/lib.rs
+check "build script passes through byte-for-byte" passthrough_case build-script jit \
+  --crate-name build_script_build crates/jit/build.rs
+check "compiler probe passes through byte-for-byte" passthrough_case probe '' -vV
+check "unknown invocation shape passes through byte-for-byte" passthrough_case unknown jit \
+  --crate-name jit --emit metadata
+
+marker="$scratch/must-not-exist"
+literal="\$(touch $marker)"
+check "shell metacharacters remain literal arguments" passthrough_case injection jit \
+  --crate-name cli_gate crates/jit/tests/cli_gate/main.rs "$literal"
+check "wrapper never evaluates an argument" test ! -e "$marker"
+
+for conflict in separate joined long; do
+  capture="$scratch/conflict-$conflict.args"
+  rm -f "$capture"
+  case "$conflict" in
+    separate) conflict_args=(-C opt-level=0) ;;
+    joined) conflict_args=(-Copt-level=2) ;;
+    long) conflict_args=(--codegen=opt-level=s) ;;
+  esac
+  (
+    cd "$root" || exit 99
+    CARGO_PKG_NAME=jit FAKE_CAPTURE="$capture" "$wrapper" "$fake_rustc" \
+      --crate-name jit crates/jit/src/lib.rs "${conflict_args[@]}"
+  ) >"$scratch/conflict-$conflict.out" 2>"$scratch/conflict-$conflict.err"
+  rc=$?
+  check "conflicting opt-level form $conflict fails closed" test "$rc" -ne 0
+  check "conflicting opt-level form $conflict never invokes rustc" test ! -e "$capture"
+done
+
+baseline_out="$scratch/baseline.out"
+baseline_err="$scratch/baseline.err"
+wrapped_out="$scratch/wrapped.out"
+wrapped_err="$scratch/wrapped.err"
+FAKE_STDOUT='stdout payload' FAKE_STDERR='stderr payload' FAKE_STATUS=42 \
+  "$fake_rustc" --crate-name cli_gate crates/jit/tests/cli_gate/main.rs \
+  >"$baseline_out" 2>"$baseline_err"
+baseline_rc=$?
+(
+  cd "$root" || exit 99
+  CARGO_PKG_NAME=jit FAKE_STDOUT='stdout payload' FAKE_STDERR='stderr payload' FAKE_STATUS=42 \
+    "$wrapper" "$fake_rustc" --crate-name cli_gate crates/jit/tests/cli_gate/main.rs
+) >"$wrapped_out" 2>"$wrapped_err"
+wrapped_rc=$?
+check "passthrough preserves exit status" test "$wrapped_rc" -eq "$baseline_rc"
+check "passthrough preserves stdout" cmp -s "$baseline_out" "$wrapped_out"
+check "passthrough preserves stderr" cmp -s "$baseline_err" "$wrapped_err"
+
+set +e
+FAKE_ACTION=term "$fake_rustc" -vV >/dev/null 2>&1
+baseline_signal_rc=$?
+(
+  cd "$root" || exit 99
+  CARGO_PKG_NAME= FAKE_ACTION=term "$wrapper" "$fake_rustc" -vV
+) >/dev/null 2>&1
+wrapped_signal_rc=$?
+set -e
+check "passthrough preserves signal-derived status" test "$wrapped_signal_rc" -eq "$baseline_signal_rc"
+
+audit_dir="$scratch/audit"
+mkdir "$audit_dir"
+(
+  cd "$root" || exit 99
+  CARGO_PKG_NAME=jit JIT_RUSTC_WRAPPER_AUDIT_DIR="$audit_dir" \
+    "$wrapper" "$fake_rustc" --crate-name jit crates/jit/src/lib.rs
+)
+check "one invocation emits one NUL-delimited audit record" \
+  test "$(find "$audit_dir" -type f | wc -l)" -eq 1
+check "audit record classifies the optimized invocation" python3 - "$audit_dir" <<'PY'
+import pathlib
+import sys
+
+files = list(pathlib.Path(sys.argv[1]).iterdir())
+fields = dict(
+    field.split(b"=", 1)
+    for field in files[0].read_bytes().split(b"\0")
+    if field
+)
+expected = {
+    b"version": b"1",
+    b"package": b"jit",
+    b"crate": b"jit",
+    b"root": str(pathlib.Path("crates/jit/src/lib.rs").resolve()).encode(),
+    b"has_test": b"0",
+    b"decision": b"optimize",
+}
+raise SystemExit(0 if expected.items() <= fields.items() else 1)
+PY
+
+stage_root="$scratch/stage"
+staged=$(JIT_RUSTC_WRAPPER_STAGE_ROOT="$stage_root" "$stager")
+source_sha=$(sha256sum "$wrapper" | awk '{print $1}')
+check "staged wrapper path contains its exact SHA-256 digest" \
+  test "$staged" = "$stage_root/$source_sha/jit-rustc-workspace-wrapper"
+check "staged wrapper is byte-identical" cmp -s "$wrapper" "$staged"
+check "staged wrapper is an executable ordinary file" test -f "$staged" -a -x "$staged" -a ! -L "$staged"
+check "staging is idempotent for verified content" \
+  test "$(JIT_RUSTC_WRAPPER_STAGE_ROOT="$stage_root" "$stager")" = "$staged"
+
+conflict_stage_root="$scratch/conflict-stage"
+conflict_staged="$conflict_stage_root/$source_sha/jit-rustc-workspace-wrapper"
+mkdir -p "$(dirname "$conflict_staged")"
+printf 'unexpected content\n' >"$conflict_staged"
+chmod +x "$conflict_staged"
+set +e
+JIT_RUSTC_WRAPPER_STAGE_ROOT="$conflict_stage_root" "$stager" \
+  >"$scratch/stage-conflict.out" 2>"$scratch/stage-conflict.err"
+stage_conflict_rc=$?
+set -e
+check "staging refuses an unexpected preexisting wrapper" test "$stage_conflict_rc" -ne 0
+check "staging never overwrites unexpected preexisting content" \
+  grep -qF 'unexpected content' "$conflict_staged"
+
+if [[ "$fail" -eq 0 ]]; then
+  echo 'SELFTEST: all assertions passed'
+else
+  echo 'SELFTEST: assertions FAILED'
+fi
+exit "$fail"
