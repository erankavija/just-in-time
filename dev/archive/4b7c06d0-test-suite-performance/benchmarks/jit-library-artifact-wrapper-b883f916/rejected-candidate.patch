index 0000000000000000000000000000000000000000..79d82c9291a38a7369089376e2de15e57f5b12ed
--- /dev/null
+++ b/scripts/stage-jit-rustc-workspace-wrapper.sh
@@ -0,0 +1,61 @@
+#!/usr/bin/env bash
+# Publish the tracked compiler wrapper at a path containing its SHA-256. Cargo
+# fingerprints RUSTC_WORKSPACE_WRAPPER by path; the digest component therefore
+# makes a content change a new compiler input. Existing content is reused only
+# after byte, digest, type, and executable-mode verification.
+set -euo pipefail
+
+script_dir=$(cd "$(dirname "$0")" && pwd)
+source_wrapper="$script_dir/jit-rustc-workspace-wrapper.sh"
+stage_root=${JIT_RUSTC_WRAPPER_STAGE_ROOT:-${TMPDIR:-/tmp}/jit-rustc-workspace-wrappers}
+
+for tool in sha256sum cmp mktemp; do
+  command -v "$tool" >/dev/null 2>&1 || {
+    echo "stage-jit-rustc-workspace-wrapper: required tool not found: $tool" >&2
+    exit 2
+  }
+done
+if [[ ! -f "$source_wrapper" || -L "$source_wrapper" || ! -x "$source_wrapper" ]]; then
+  echo "stage-jit-rustc-workspace-wrapper: source is not an executable ordinary file: $source_wrapper" >&2
+  exit 2
+fi
+if [[ -e "$stage_root" && (! -d "$stage_root" || -L "$stage_root") ]]; then
+  echo "stage-jit-rustc-workspace-wrapper: stage root is not an ordinary directory: $stage_root" >&2
+  exit 2
+fi
+mkdir -p -- "$stage_root"
+
+digest=$(sha256sum "$source_wrapper" | awk '{print $1}')
+digest_dir="$stage_root/$digest"
+destination="$digest_dir/jit-rustc-workspace-wrapper"
+if [[ -e "$digest_dir" && (! -d "$digest_dir" || -L "$digest_dir") ]]; then
+  echo "stage-jit-rustc-workspace-wrapper: digest path is not an ordinary directory: $digest_dir" >&2
+  exit 2
+fi
+mkdir -p -- "$digest_dir"
+
+if [[ ! -e "$destination" ]]; then
+  partial=$(mktemp "$digest_dir/.wrapper.XXXXXX")
+  trap 'rm -f -- "${partial:-}"' EXIT
+  cp -- "$source_wrapper" "$partial"
+  chmod 0555 "$partial"
+  mv -n -- "$partial" "$destination"
+  rm -f -- "$partial"
+  trap - EXIT
+fi
+
+if [[ ! -f "$destination" || -L "$destination" || ! -x "$destination" ]]; then
+  echo "stage-jit-rustc-workspace-wrapper: staged path is not an executable ordinary file: $destination" >&2
+  exit 2
+fi
+if ! cmp -s -- "$source_wrapper" "$destination"; then
+  echo "stage-jit-rustc-workspace-wrapper: refusing unexpected preexisting content: $destination" >&2
+  exit 2
+fi
+staged_digest=$(sha256sum "$destination" | awk '{print $1}')
+if [[ "$staged_digest" != "$digest" ]]; then
+  echo "stage-jit-rustc-workspace-wrapper: staged digest mismatch: expected $digest, got $staged_digest" >&2
+  exit 2
+fi
+
+printf '%s\n' "$destination"
