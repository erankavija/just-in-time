# Source in zsh with S=<this directory copied to scratch>, then: mkbrief <id> <lead-notes.md>
# Writes $S/brief-<id>.md: worktree header, the issue text, lead notes, then brief-rules.md (jit:<id> substituted).
# For a Codex worker, append codex-git-rule.md and "Do not write report files into the repository."
mkbrief(){ id=$1; extra=$2; { echo "You are implementing JIT issue $id. Your worktree is /home/vkaskivuo/Projects/just-in-time/.agents/worktrees/agent-$id (branch worktree-agent-$id), anchored to current main. Run every command from it with relative paths; never write to /home/vkaskivuo/Projects/just-in-time itself or another worktree; never checkout/switch/rebase/reset/push. Export TMPDIR=/mnt/nvme/jit/tmp/df129d9e-workers/$id and CARGO_INCREMENTAL=0 for every build and test."; echo; echo "## Issue"; echo; jit issue show $id --json | python3 -c "import json,sys;d=json.load(sys.stdin);print(d['title']);print();print(d['description'])"; echo; echo "## Lead notes"; echo; cat $extra; sed "s/jit:8fbf8c43/jit:$id/" $S/brief-rules.md; } > $S/brief-$id.md; }
