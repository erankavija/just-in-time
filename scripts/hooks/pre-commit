#!/usr/bin/env bash
# Pre-commit hook for JIT: shared configuration changes require common history
# with main.
#
# Leases are enforced when a mutation is written, so this hook does not check
# them; a hand edit of an issue record is not caught at commit.
#
# Installation:
#   jit hooks install
#
# Skip enforcement (emergency override):
#   git commit --no-verify

set -euo pipefail

if ! enforcement_mode=$(jit config get worktree.enforce_leases 2> /dev/null); then
  echo "warning: Pre-commit hook: jit could not read the enforcement mode, skipping" >&2
  exit 0
fi
if [ "$enforcement_mode" = "off" ]; then
  exit 0
fi

if git diff --cached --name-only | grep -qE '^\.jit/(config|gates)\.toml$'; then
  base=$(git merge-base HEAD origin/main 2>/dev/null || git merge-base HEAD main 2>/dev/null || echo "")
  main=$(git rev-parse origin/main 2>/dev/null || git rev-parse main 2>/dev/null || echo "")

  if [ -n "$base" ] && [ -n "$main" ] && [ "$base" != "$main" ]; then
    echo "error: Pre-commit hook: Global .jit/ changes require common history with main" >&2
    echo "   Your branch has diverged from origin/main" >&2
    echo "" >&2
    echo "   To proceed:" >&2
    echo "     git rebase origin/main" >&2
    echo "" >&2
    echo "   Or skip this hook (emergency only):" >&2
    echo "     git commit --no-verify" >&2
    exit 1
  fi
fi
